{
  "name": "@practice/api",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:promote": "tsx src/promote-admin.ts",
    "dev": "prisma generate && tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "start": "node dist/index.js",
    "test": "prisma generate && NODE_ENV=test tsx --test src/index.test.ts",
    "typecheck": "prisma generate && tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.15",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "1.7.15",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
